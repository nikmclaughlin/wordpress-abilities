includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5
	paths:
		- src
		- tests
	excludePaths:
		analyse:
			- tests/Fixtures
	stubFiles:
		# Abilities API symbols (new in core trunk, not yet in phpstan-wordpress).
		- .stubs/abilities-api.php
		# get_registered_settings() as of 7.2 (phpstan-wordpress predates `show_in_abilities`).
		- .stubs/option.php
